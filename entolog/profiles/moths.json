    {"name": "worn", "type": "choice", "key": "w", "choices": ["", "fresh", "worn"]},
    {"name": "retained", "type": "bool", "key": "r", "help": "kept for dissection"},
    {"name": "host_plant", "type": "text", "learn": true, "key": "p",
     "dwc": "associatedTaxa", "help": "for larvae and mines"},
    {"name": "notes", "type": "multiline", "dwc": "occurrenceRemarks"}
  ],
  "entry": {"order": ["taxon", "count", "trap", "notes", "worn", "retained", "host_plant"]},
  "export": {"columns": ["filename", "date", "time", "gridref", "locality",
