{
  "name": "insects",
  "title": "Insect records",
  "primary": "species",
  "fields": [
    {"name": "species", "type": "text", "learn": true, "primary": true,
     "dwc": "scientificName", "help": "genus and species, or as far as you can take it"},
    {"name": "stage", "type": "choice", "digits": true, "dwc": "lifeStage",
     "choices": ["adult", "larva", "nymph", "pupa", "egg", "exuvia", "case", "mine", "gall"]},
    {"name": "sex", "type": "choice", "key": "x", "dwc": "sex",
     "choices": ["", "male", "female", "worker", "queen", "unknown"]},
    {"name": "confidence", "type": "choice", "key": "c",
     "dwc": "identificationVerificationStatus",
     "choices": ["", "certain", "probable", "aggregate", "needs dissection"]},
    {"name": "comments", "type": "multiline", "dwc": "occurrenceRemarks",
     "help": "habitat, host plant, behaviour, how it was determined"}
  ],
  "entry": {"order": ["species", "stage", "sex", "comments", "confidence"]},
  "export": {
    "columns": ["filename", "date", "time", "latitude", "longitude",
                "species", "stage", "sex", "comments"]
  }
}
